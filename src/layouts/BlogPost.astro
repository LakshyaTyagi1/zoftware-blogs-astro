---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { getSanityImageUrl } from "../utils/sanityImages";

interface Props {
    title: string;
    description?: string;
    publishedAt?: string | null;
    updatedAt?: string | null;
    coverImage?: any;
    categories?: Array<{ title: string; slug?: string | null }>;
    tags?: Array<{ title: string; slug?: string | null }>;
}

const {
    title,
    description,
    publishedAt,
    updatedAt,
    coverImage,
    categories,
    tags,
} = Astro.props;

const publishedDate = publishedAt ? new Date(publishedAt) : null;
const updatedDate = updatedAt ? new Date(updatedAt) : null;
const coverImageUrl = coverImage
    ? getSanityImageUrl(coverImage, { width: 1200, height: 630 })
    : "";
---

<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>

    <body class="flex flex-col min-h-screen">
        <Header />

        <main
            class="max-w-[1200px] mx-auto px-6 pt-28 sm:pt-32 lg:pt-36 pb-16 flex-1"
        >
            <article>
                <!-- Header -->
                <header class="mb-10">
                    <!-- Category -->
                    {
                        categories && categories[0] && (
                            <p class="text-xs uppercase tracking-[0.2em] text-slate-500 mb-4">
                                {categories[0].title}
                            </p>
                        )
                    }

                    <!-- Title -->
                    <h1
                        class="text-3xl md:text-4xl lg:text-5xl font-semibold text-slate-900 mb-5 tracking-[-0.02em]"
                    >
                        {title}
                    </h1>

                    <!-- Meta info -->
                    <div
                        class="flex flex-wrap items-center gap-3 text-xs text-slate-500"
                    >
                        <div class="flex items-center gap-2">
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                ></path>
                            </svg>
                            {
                                publishedDate && (
                                    <FormattedDate date={publishedDate} />
                                )
                            }
                        </div>
                        <span class="text-slate-300">•</span>
                        <span>8 min read</span>
                        {
                            updatedDate && (
                                <>
                                    <span class="text-slate-300">•</span>
                                    <span>
                                        Updated:{" "}
                                        <FormattedDate date={updatedDate} />
                                    </span>
                                </>
                            )
                        }
                    </div>
                </header>

                <!-- Featured image -->
                {
                    coverImage && coverImageUrl && (
                        <div class="mb-12 rounded-2xl overflow-hidden border border-slate-200 bg-white">
                            <img
                                width={1200}
                                height={630}
                                src={coverImageUrl}
                                alt={coverImage?.alt || title}
                                onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=\'w-full h-64 flex items-center justify-center bg-slate-100\'><svg class=\'w-16 h-16 text-slate-300\' fill=\'none\' stroke=\'currentColor\' viewBox=\'0 0 24 24\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'2\' d=\'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\' /></svg></div>'"
                                class="w-full h-auto object-cover"
                            />
                        </div>
                    )
                }

                <div
                    class="grid gap-10 lg:grid-cols-[minmax(260px,30%)_minmax(0,1fr)] lg:gap-12"
                    data-toc-layout
                >
                    <aside class="order-2 lg:order-1">
                        <div class="lg:sticky lg:top-28 space-y-6">
                            <div
                                class="rounded-2xl border border-slate-200 bg-white p-5"
                            >
                                <p
                                    class="text-xs uppercase tracking-[0.25em] text-slate-500 mb-5"
                                >
                                    In this post
                                </p>
                                <nav
                                    class="space-y-4 text-sm text-slate-600"
                                    data-toc="desktop"
                                >
                                </nav>
                            </div>

                            <!-- Share Section -->
                            <div
                                class="rounded-2xl border border-slate-200 bg-white p-6"
                            >
                                <h3
                                    class="text-lg font-semibold text-slate-900 mb-4"
                                >
                                    Share this article
                                </h3>
                                <button
                                    type="button"
                                    data-share-blog
                                    class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50"
                                >
                                    <svg
                                        class="h-4 w-4"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M8.684 13.342C8.886 12.938 9 12.482 9 12s-.114-.938-.316-1.342m0 2.684a3 3 0 11.632-2.684m-.632 2.684l6.632 3.316m-6.632-6.316l6.632-3.316M15 6a3 3 0 106 0 3 3 0 00-6 0zm0 12a3 3 0 106 0 3 3 0 00-6 0z"
                                        ></path>
                                    </svg>
                                    Share this blog
                                </button>
                                <p
                                    data-share-status
                                    class="mt-3 hidden text-xs text-slate-500"
                                    aria-live="polite"
                                >
                                </p>
                            </div>

                            <!-- Newsletter Signup -->
                            <div
                                data-newsletter-card
                                class="rounded-2xl border border-slate-200 bg-white p-6"
                            >
                                <div
                                    data-newsletter-content
                                    class="transition-opacity duration-200"
                                >
                                    <h3
                                        class="text-lg font-semibold text-slate-900 mb-2"
                                    >
                                        Subscribe to Our Newsletter
                                    </h3>
                                    <p
                                        class="text-slate-600 mb-4 text-sm leading-relaxed"
                                    >
                                        Get the latest software reviews and
                                        insights delivered to your inbox.
                                    </p>

                                    <form class="space-y-3" data-newsletter-form>
                                        <input
                                            required
                                            name="email"
                                            type="email"
                                            autocomplete="email"
                                            placeholder="Your email address"
                                            class="w-full px-4 py-2 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900/10 focus:border-slate-900 text-sm"
                                        />
                                        <button
                                            type="submit"
                                            class="w-full py-2 rounded-xl bg-slate-900 text-white font-semibold hover:bg-slate-800 transition text-sm disabled:cursor-not-allowed disabled:bg-slate-400"
                                        >
                                            Subscribe
                                        </button>
                                        <p
                                            data-newsletter-error
                                            class="hidden text-xs text-red-600"
                                            aria-live="polite"
                                        >
                                        </p>
                                    </form>

                                    <p class="text-xs text-slate-500 mt-3">
                                        We respect your privacy. Unsubscribe at
                                        any time.
                                    </p>
                                </div>

                                <div
                                    data-newsletter-confirmation
                                    class="hidden transition-opacity duration-200"
                                    aria-live="polite"
                                >
                                    <h3
                                        class="text-lg font-semibold text-slate-900 mb-2"
                                    >
                                        Thanks for signing up.
                                    </h3>
                                    <p
                                        class="text-sm leading-relaxed text-slate-600"
                                    >
                                        You will receive newsletters at{" "}
                                        <span
                                            data-newsletter-confirmation-email
                                            class="font-semibold text-slate-900 break-words"
                                        ></span>.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </aside>

                    <div class="order-1 lg:order-2">
                        <!-- Content -->
                        <div class="prose prose-lg max-w-none">
                            <slot />
                        </div>

                        <!-- CTA Section -->
                        <section class="mt-8 sm:mt-12">
                            <div
                                class="rounded-2xl border border-slate-200 bg-[radial-gradient(600px_300px_at_10%_0%,#E7F0FF_0%,transparent_70%)] p-6 sm:p-8"
                            >
                                <h3
                                    class="text-xl sm:text-2xl font-semibold text-slate-900 mb-3 sm:mb-2 leading-tight sm:leading-normal"
                                >
                                    Transform Your Customer Experience
                                </h3>
                                <p
                                    class="text-sm sm:text-base text-slate-600 mb-6 leading-relaxed"
                                >
                                    Want to explore how unified CX and
                                    execution-led transformation can work for
                                    your organization?
                                </p>
                                <a
                                    href="https://calendly.com/gauravsawhney/zoftwarediscoverycall"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="block w-full py-2.5 sm:py-3 rounded-xl bg-brand-blue-v2 text-white text-sm sm:text-base font-semibold hover:bg-bright-blue-v2 hover:text-white transition text-center"
                                >
                                    Book Your Free CX Strategy Consulting Call
                                </a>
                            </div>
                        </section>
                    </div>
                </div>
            </article>
        </main>

        <Footer />

        <script>
            const content = document.querySelector(".prose");
            const tocTargets = document.querySelectorAll("[data-toc]");

            if (content && tocTargets.length > 0) {
                const headings = Array.from(
                    content.querySelectorAll("h2, h3, h4"),
                );
                const usedIds = new Set();

                const slugify = (text) =>
                    text
                        .toLowerCase()
                        .trim()
                        .replace(/[^\w\s-]/g, "")
                        .replace(/\s+/g, "-")
                        .replace(/-+/g, "-");

                let items = headings.map((heading) => {
                    let id = heading.id;
                    if (!id) {
                        const base = slugify(heading.textContent || "section");
                        id = base || "section";
                        let counter = 2;
                        while (usedIds.has(id) || document.getElementById(id)) {
                            id = `${base}-${counter++}`;
                        }
                        heading.id = id;
                    }
                    usedIds.add(id);
                    return {
                        id,
                        text: heading.textContent || "",
                        level: heading.tagName.toLowerCase(),
                    };
                });

                if (items.length === 0) {
                    const paragraphs = Array.from(
                        content.querySelectorAll("p"),
                    );
                    const fallback = paragraphs
                        .map((paragraph) => {
                            const strong = paragraph.querySelector("strong");
                            if (!strong) return null;
                            const text = (paragraph.textContent || "").trim();
                            if (text.length < 8 || text.length > 120)
                                return null;
                            const strongText = (
                                strong.textContent || ""
                            ).trim();
                            if (!strongText) return null;
                            return { paragraph, text: strongText };
                        })
                        .filter(Boolean);

                    items = fallback.map(({ paragraph, text }) => {
                        let id = paragraph.id;
                        if (!id) {
                            const base = slugify(text);
                            id = base || "section";
                            let counter = 2;
                            while (
                                usedIds.has(id) ||
                                document.getElementById(id)
                            ) {
                                id = `${base}-${counter++}`;
                            }
                            paragraph.id = id;
                        }
                        usedIds.add(id);
                        return {
                            id,
                            text,
                            level: "p",
                        };
                    });
                }

                const renderList = (target) => {
                    target.innerHTML = "";
                    if (items.length === 0) {
                        target.closest("aside")?.classList.add("hidden");
                        const layout = target.closest("[data-toc-layout]");
                        if (layout) {
                            layout.style.gridTemplateColumns = "minmax(0, 1fr)";
                        }
                        return;
                    }
                    items.forEach((item) => {
                        const link = document.createElement("a");
                        link.href = `#${item.id}`;
                        link.textContent = item.text;
                        link.className =
                            item.level === "p"
                                ? "block border-l-2 border-slate-200 pl-4 text-slate-500 hover:text-slate-900 hover:border-slate-400 transition leading-relaxed break-words"
                                : item.level === "h4"
                                  ? "block border-l-2 border-slate-200 pl-6 text-slate-500 hover:text-slate-900 hover:border-slate-400 transition leading-relaxed break-words"
                                  : item.level === "h3"
                                    ? "block border-l-2 border-slate-200 pl-4 text-slate-500 hover:text-slate-900 hover:border-slate-400 transition leading-relaxed break-words"
                                    : "block border-l-2 border-slate-200 pl-4 font-medium text-slate-700 hover:text-slate-900 hover:border-slate-400 transition leading-relaxed break-words";
                        target.appendChild(link);
                    });
                };

                tocTargets.forEach((target) => renderList(target));
            }

            const shareButton = document.querySelector("[data-share-blog]");
            const shareStatus = document.querySelector("[data-share-status]");

            const showShareStatus = (message) => {
                if (!shareStatus) return;
                shareStatus.textContent = message;
                shareStatus.classList.remove("hidden");
                window.setTimeout(() => {
                    shareStatus.classList.add("hidden");
                    shareStatus.textContent = "";
                }, 2500);
            };

            shareButton?.addEventListener("click", async () => {
                const shareData = {
                    title: document.title,
                    url: window.location.href,
                };

                if (navigator.share) {
                    try {
                        await navigator.share(shareData);
                    } catch (error) {
                        if (error?.name !== "AbortError") {
                            showShareStatus("Sharing is not available.");
                        }
                    }
                    return;
                }

                try {
                    await navigator.clipboard.writeText(window.location.href);
                    showShareStatus("Link copied.");
                } catch {
                    showShareStatus("Copy the page URL from your browser.");
                }
            });

            const newsletterForm = document.querySelector(
                "[data-newsletter-form]",
            );
            const newsletterContent = document.querySelector(
                "[data-newsletter-content]",
            );
            const newsletterConfirmation = document.querySelector(
                "[data-newsletter-confirmation]",
            );
            const newsletterConfirmationEmail = document.querySelector(
                "[data-newsletter-confirmation-email]",
            );
            const newsletterError = document.querySelector(
                "[data-newsletter-error]",
            );

            const setNewsletterError = (message) => {
                if (!newsletterError) return;
                newsletterError.textContent = message;
                newsletterError.classList.toggle("hidden", !message);
            };

            newsletterForm?.addEventListener("submit", async (event) => {
                event.preventDefault();

                if (!newsletterForm.reportValidity()) return;

                const input = newsletterForm.querySelector(
                    "input[name='email']",
                );
                const button = newsletterForm.querySelector(
                    "button[type='submit']",
                );
                const email = input?.value.trim();

                if (!email) return;

                setNewsletterError("");
                if (button) {
                    button.disabled = true;
                    button.textContent = "Subscribing...";
                }

                try {
                    const response = await fetch("/api/newsletter.json", {
                        method: "POST",
                        headers: { "content-type": "application/json" },
                        body: JSON.stringify({
                            email,
                            pageTitle: document.title,
                            pageUrl: window.location.href,
                        }),
                    });

                    if (!response.ok) {
                        const result = await response.json().catch(() => ({}));
                        throw new Error(
                            result.error || "Subscription failed",
                        );
                    }

                    if (newsletterConfirmationEmail) {
                        newsletterConfirmationEmail.textContent = email;
                    }
                    newsletterContent?.classList.add("hidden");
                    newsletterConfirmation?.classList.remove("hidden");

                    window.setTimeout(() => {
                        newsletterConfirmation?.classList.add("hidden");
                        newsletterContent?.classList.remove("hidden");
                        newsletterForm.reset();
                    }, 3000);
                } catch (error) {
                    setNewsletterError(
                        error?.message || "Subscription failed",
                    );
                } finally {
                    if (button) {
                        button.disabled = false;
                        button.textContent = "Subscribe";
                    }
                }
            });
        </script>

        <style is:global>
            /* Article Content Styling */
            .prose {
                color: #475569;
            }

            .prose p {
                margin-bottom: 1.5rem;
                line-height: 170%;
                font-size: 1rem;
            }

            .prose h2 {
                font-size: 1.875rem;
                font-weight: 600;
                color: #0f172a;
                margin-top: 2rem;
                margin-bottom: 1rem;
                line-height: 120%;
            }

            .prose h3 {
                font-size: 1.5rem;
                font-weight: 600;
                color: #0f172a;
                margin-top: 1.5rem;
                margin-bottom: 0.75rem;
                line-height: 120%;
            }

            .prose h4 {
                font-size: 1.25rem;
                font-weight: 600;
                color: #0f172a;
                margin-top: 1.5rem;
                margin-bottom: 0.75rem;
            }

            .prose h5,
            .prose h6 {
                font-size: 1rem;
                font-weight: 600;
                color: #0f172a;
                margin-top: 1rem;
                margin-bottom: 0.5rem;
            }

            .prose ul,
            .prose ol {
                margin-bottom: 1.5rem;
                padding-left: 1.5rem;
            }

            .prose li {
                margin-bottom: 0.5rem;
                line-height: 170%;
            }

            .prose a {
                color: #1447e6;
                text-decoration: underline;
            }

            .prose a:hover {
                color: #007bef;
            }

            .prose strong,
            .prose b {
                font-weight: 600;
                color: #0f172a;
            }

            .prose blockquote {
                border-left: 3px solid #1447e6;
                background-color: #f1f5f9;
                padding: 1.5rem;
                margin: 1.5rem 0;
                border-radius: 8px;
                font-style: italic;
                color: #0f172a;
            }

            .prose code {
                background-color: #f1f5f9;
                padding: 2px 6px;
                border-radius: 4px;
                font-size: 0.875rem;
                color: #0f172a;
            }

            .prose pre {
                background-color: #0f172a;
                padding: 1.5rem;
                border-radius: 8px;
                overflow-x: auto;
                margin: 1.5rem 0;
            }

            .prose pre code {
                background: none;
                padding: 0;
                color: white;
            }

            .prose img {
                border-radius: 12px;
                margin: 1.5rem 0;
            }

            .prose table {
                width: 100%;
                border-collapse: collapse;
                margin: 1.5rem 0;
            }

            .prose th,
            .prose td {
                padding: 0.75rem;
                border: 1px solid #e2e8f0;
                text-align: left;
            }

            .prose th {
                background-color: #f1f5f9;
                font-weight: 600;
                color: #0f172a;
            }

            .prose hr {
                border: none;
                border-top: 1px solid #e2e8f0;
                margin: 2rem 0;
            }
        </style>
    </body>
</html>
