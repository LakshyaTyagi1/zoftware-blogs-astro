{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/categories\\.json/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/latest-blogs\\.json/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/sanity-webhook/?$",
			"dest": "_render"
		},
		{
			"src": "^/page/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/?$",
			"dest": "_render"
		}
	]
}